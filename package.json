{
  "name": "livehub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "跨平台直播工作台：主播库 + 应用内播放器 + 桌面端平台原页互动",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "desktop": "electron desktop/main.cjs",
    "desktop:dev": "electron desktop/main.cjs --remote-debugging-port=9333",
    "dist": "electron-builder --mac",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --mac --dir",
    "dist:all": "electron-builder --mac --win --linux",
    "sync:app": "node scripts/sync-app.mjs",
    "sync:app:diff": "node scripts/sync-app.mjs --diff"
  },
  "dependencies": {
    "express": "^4.21.2",
    "hls.js": "^1.5.20",
    "mpegts.js": "^1.8.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.livehub.desktop",
    "productName": "LiveHub",
    "copyright": "LiveHub",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "web/**/*",
      "package.json",
      "!data/**",
      "!dist/**",
      "!build/**",
      "!.workbuddy/**",
      "!**/*.md",
      "seed/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "LiveHub",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Video"
    }
  },
  "author": "LiveHub"
}
